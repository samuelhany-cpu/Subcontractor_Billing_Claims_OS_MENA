    {
      "parameters": {
        "jsCode": "const request = $('Authorize and Normalize Balance Update').first().json;\nconst payloads = $input.all().map((item) => item.json);\nconst projects = payloads.flatMap((payload) => Array.isArray(payload) ? payload : Array.isArray(payload?.data) ? payload.data : payload && typeof payload === 'object' ? [payload] : []);\nconst active = projects.filter((project) => project && typeof project.id === 'string' && typeof project.name === 'string' && project.status === 'ACTIVE').slice(0, 10);\nconst now = Date.now();\nconst conversationId = `${request.chatId.slice(-8)}-${Number(request.updateId).toString(36)}`;\nconst state = { telegramChatId: request.chatId, conversationId, intent: 'QUERY_BALANCE', step: active.length === 0 ? 'COMPLETED' : 'WAITING_FOR_PROJECT_SELECTION', projectId: '', collectedJson: active.length === 0 ? '{}' : JSON.stringify({ projects: active.map((project) => ({ id: project.id, name: project.name })) }), revision: 1, expiresAt: active.length === 0 ? new Date(now).toISOString() : new Date(now + 15 * 60_000).toISOString(), lastUpdateId: request.updateId };\nif (active.length === 0) return [{ json: { noProjects: true, reply: 'لا توجد مشاريع نشطة حالياً.', state } }];\nconst choices = active.map((project) => ({ id: project.id, name: project.name }));\nconst buttons = choices.map((project, index) => ([{ text: project.name, callback_data: `b:1:${index}` }]));\nconst reply = choices.length === 1 ? `هل تريد معرفة رصيد مشروع ${choices[0].name}؟` : 'اختر المشروع لمعرفة الرصيد:';\nreturn [{ json: { noProjects: false, reply, buttons, state } }];"
      },
