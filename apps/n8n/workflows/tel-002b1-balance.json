    {
      "parameters": {
        "jsCode": "const dashboard = $json;\nconst selected = $('Validate Project Selection Callback').first().json;\nconst fields = ['openingBalance', 'totalIncomingTransfers', 'totalExpenses', 'availableBalance'];\nconst valid = dashboard && dashboard.projectId === selected.projectId && fields.every((field) => typeof dashboard[field] === 'string');\nif (!valid) return [{ json: { valid: false, reply: 'تعذر جلب رصيد المشروع الآن. حاول مرة أخرى لاحقاً.' } }];\nconst money = (value) => `${value} ج.م`;\nconst reply = `رصيد المشروع: ${selected.projectName}\\n\\nرصيد البداية: ${money(dashboard.openingBalance)}\\nإجمالي التحويلات الواردة: ${money(dashboard.totalIncomingTransfers)}\\nإجمالي المصروفات: ${money(dashboard.totalExpenses)}\\nالرصيد المتاح: ${money(dashboard.availableBalance)}`;\nreturn [{ json: { valid: true, reply, projectId: selected.projectId, projectName: selected.projectName } }];"
      },
