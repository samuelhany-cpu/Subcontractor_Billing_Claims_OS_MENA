    {
      "parameters": {
        "jsCode": "const update = $json.body?.update;\nconst supplied = $json.headers?.['x-gateway-secret'];\nif (!update || supplied !== $env.GATEWAY_N8N_SECRET) throw new Error('UNAUTHORIZED_GATEWAY_REQUEST');\nconst callback = update.callback_query;\nconst message = update.message;\nconst chatId = String(callback?.message?.chat?.id ?? message?.chat?.id ?? '');\nif (!chatId || chatId !== String($env.TELEGRAM_ALLOWED_CHAT_ID)) throw new Error('UNAUTHORIZED_TELEGRAM_CHAT');\nif (callback) {\n  return [{ json: { kind: 'CALLBACK', chatId, updateId: String(update.update_id), callbackId: callback.id, callbackData: String(callback.data ?? '') } }];\n}\nconst text = String(message?.text ?? '').trim();\nif (!['/balance', 'الرصيد', 'الرصيد كام؟', 'فاضل كام؟'].includes(text)) throw new Error('UNSUPPORTED_BALANCE_MESSAGE');\nreturn [{ json: { kind: 'MESSAGE', chatId, updateId: String(update.update_id), text } }];"
      },
