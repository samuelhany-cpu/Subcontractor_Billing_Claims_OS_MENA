    {
      "parameters": {
        "jsCode": "const request = $('Authorize and Normalize Balance Update').first().json;\nconst state = $json;\nconst invalid = (reason) => [{ json: { valid: false, callbackId: request.callbackId, callbackText: reason } }];\nif (!state?.telegramChatId || state.telegramChatId !== request.chatId) return invalid('الاختيار غير متاح. اكتب /balance من جديد.');\nif (state.intent !== 'QUERY_BALANCE' || state.step !== 'WAITING_FOR_PROJECT_SELECTION') return invalid('هذا الاختيار لم يعد صالحاً. اكتب /balance من جديد.');\nif (Date.now() >= Date.parse(state.expiresAt)) return invalid('انتهت مهلة الاختيار. اكتب /balance من جديد.');\nconst parts = String(request.callbackData).split(':');\nif (parts.length !== 3 || parts[0] !== 'b') return invalid('اختيار مشروع غير صالح.');\nconst revision = Number(parts[1]); const index = Number(parts[2]);\nif (!Number.isInteger(revision) || revision !== Number(state.revision) || !Number.isInteger(index) || index < 0) return invalid('هذا الاختيار قديم. اكتب /balance من جديد.');\nlet context; try { context = JSON.parse(state.collectedJson); } catch { return invalid('تعذر قراءة الاختيار. اكتب /balance من جديد.'); }\nconst project = Array.isArray(context.projects) ? context.projects[index] : undefined;\nif (!project || typeof project.id !== 'string' || typeof project.name !== 'string') return invalid('المشروع غير متاح. اكتب /balance من جديد.');\nreturn [{ json: { valid: true, callbackId: request.callbackId, callbackText: 'جارٍ جلب الرصيد…', state, projectId: project.id, projectName: project.name, nextRevision: revision + 1 } }];"
      },
