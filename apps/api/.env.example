# API server
NODE_ENV=development
SERVICE_NAME=claims-os-api
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
LOG_FORMAT=json
REQUEST_LOGGING=true
HEALTH_CHECK_TIMEOUT_MS=1000

# Server-only PostgreSQL connection
DATABASE_URL=postgresql://claims_local:claims_local_password@localhost:55432/claims_os

# Server-only Redis connection
REDIS_URL=redis://:claims_local_redis_password@localhost:6379/0

# Server-only private S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=claims-documents-local
OBJECT_STORAGE_ACCESS_KEY=claims_local_minio
OBJECT_STORAGE_SECRET_KEY=claims_local_minio_secret
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_FORCE_PATH_STYLE=true
