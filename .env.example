POSTGRES_DB=claims_os
POSTGRES_USER=claims_local
POSTGRES_PASSWORD=claims_local_password

REDIS_PORT=6379
REDIS_PASSWORD=claims_local_redis_password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=claims_local_minio
MINIO_ROOT_PASSWORD=claims_local_minio_secret
MINIO_BUCKET=claims-documents-local
