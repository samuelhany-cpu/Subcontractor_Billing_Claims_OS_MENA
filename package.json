{
  "name": "subcontractor-claims-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @claims-os/api start:dev",
    "dev:web": "pnpm --filter @claims-os/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:check": "pnpm --filter @claims-os/api infra:check",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --tail=200",
    "infra:reset": "docker compose down --volumes --remove-orphans",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up -d",
    "prod:build": "docker compose --env-file .env.production -f docker-compose.production.yml build",
    "prod:config": "docker compose --env-file .env.production -f docker-compose.production.yml config",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.production.yml down",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.production.yml logs --tail=200 -f",
    "prod:migrate": "docker compose --env-file .env.production -f docker-compose.production.yml run --rm migrate",
    "prod:status": "docker compose --env-file .env.production -f docker-compose.production.yml ps",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.production.yml up -d --build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
