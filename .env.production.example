# Copy to .env.production and replace every CHANGE_ME value before startup.
# Use URL-safe secrets, or percent-encode them in DATABASE_URL and REDIS_URL.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated host[:port] values for Next.js Server Actions, without scheme.
NEXT_SERVER_ACTIONS_ALLOWED_ORIGINS=localhost:3000

POSTGRES_DB=claims_os
POSTGRES_USER=claims_runtime
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://claims_runtime:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/claims_os

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

MINIO_ROOT_USER=claims_runtime_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=claims-documents
# Optional only when the official MinIO registry is unavailable on this host:
# MINIO_IMAGE=registry.example/minio:verified-pinned-tag
# MINIO_MC_IMAGE=registry.example/mc:verified-pinned-tag

LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=1000
